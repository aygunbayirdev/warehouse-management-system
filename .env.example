# PostgreSQL
POSTGRES_DB=wms
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=wms_password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=5000
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Frontend
FRONTEND_PORT=3000
# Baked into the frontend build (Vite reads env vars at build time, not at container
# runtime), so this must be the URL the *browser* can reach the backend at, i.e. the
# host-mapped BACKEND_PORT above - not the in-network "backend" service name.
VITE_API_URL=http://localhost:5000/api
